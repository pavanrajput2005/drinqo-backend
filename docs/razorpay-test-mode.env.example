# Copy these names into a local secret manager or untracked environment file.
# Never commit real values. The default keeps payments disabled.
RAZORPAY_TEST_MODE_ENABLED=false
RAZORPAY_PAYMENT_GATEWAY_MODE=disabled
RAZORPAY_KEY_ID=rzp_test_replace_with_merchant_test_key
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
# Current webhook secret first; an optional previous secret second during rotation.
RAZORPAY_WEBHOOK_SECRETS=replace_with_current_webhook_secret
# A singular RAZORPAY_WEBHOOK_SECRET is also accepted for a one-secret setup.
RAZORPAY_LIVE_PAYMENT_AUTHORIZED=false

# Do not set rzp_live_ credentials. DRINQO source intentionally rejects them
# until merchant/category approval and a separately reviewed live-mode release.
